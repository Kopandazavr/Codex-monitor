<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="Live monitor">
        <Preference
            android:key="now_bar_permission"
            android:summary="System notification settings"
            android:title="Notifications"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Alert sounds">
        <SwitchPreferenceCompat
            android:key="alert_sounds_phone_speaker"
            android:defaultValue="false"
            android:summary="Best effort for Process completion and Limits reset alerts"
            android:title="Play alert sounds on phone speaker"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Long-running processes">
        <dev.oneuiproject.oneui.preference.HorizontalRadioPreference
            android:defaultValue="combined"
            android:key="process_notification_mode_ui"
            android:title="Process notifications"
            app:entries="@array/process_notification_mode_entries"
            app:entryValues="@array/process_notification_mode_values"
            app:viewType="noImage" />
    </PreferenceCategory>
</PreferenceScreen>
